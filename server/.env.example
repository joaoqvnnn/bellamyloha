# ==================== SERVIDOR ====================
NODE_ENV=production
PORT=3000

# URL do frontend (para CORS e link nos e-mails)
FRONTEND_URL=https://streamly.onrender.com

# URL do próprio backend (para webhooks do Mercado Pago)
BASE_URL=https://streamly-backend.onrender.com

# ==================== BANCO DE DADOS ====================
# Preenchido automaticamente pelo Render ao criar o Postgres
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# ==================== JWT ====================
JWT_SECRET=gere_com_openssl_rand_hex_64
JWT_EXPIRES_REMEMBER=7d
JWT_EXPIRES_SHORT=4h

# ==================== SMTP (e-mail) ====================
# Opção A: Gmail (só para teste — limite 500/dia)
# SMTP_SERVICE=gmail
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# Opção B: provedor transacional (recomendado em produção)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxx

MAIL_FROM=STREAMLY <noreply@streamly.com.br>
MAIL_REPLY_TO=suporte@streamly.com.br

# ==================== MERCADO PAGO ====================
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ==================== OPENAI ====================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600
SUPPORT_RATE_PER_MIN=20
